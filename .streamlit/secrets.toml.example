# Copy to .streamlit/secrets.toml (git- and docker-ignored) and set
# BRAINBREW_REQUIRE_LOGIN=1 to require login. Any OIDC provider works; see
# https://docs.streamlit.io/develop/concepts/connections/authentication
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-with: python -c 'import secrets; print(secrets.token_urlsafe(32))'"
client_id = "your-client-id"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
